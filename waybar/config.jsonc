// archy: Waybar configuration.
//
// Layout, left to right:
//   left    launcher, workspaces (only the ones that exist), now-playing marquee
//   centre  clock
//   right   network, notifications, audio, bluetooth, tray
//
// Colors come entirely from generated/waybar.css, which archy-theme writes from
// colors/colors.conf. The bar is started with `waybar -s <that file>` from
// autostart.lua, so retheming never needs an edit here.
//
// The bar has no background of its own. It sits on the wallpaper, so the
// wallpaper is what you see behind it, and the module text is what has to stay
// legible against whatever is there. Right-click anywhere toggles the bar's
// opacity through archy-toggle, which is the same key as before.

{
  "layer": "top",
  "position": "top",

  // 26px, matching the reserved strip the Quake console measures against.
  "height": 26,

  // Flush to the edges. The bar is a strip over the wallpaper, not a floating
  // panel, so no margin and no rounding.
  "margin": "0px 0px 0px 0px",

  "spacing": 0,

  "reload_interval": 1,
  "continuous": true,

  "modules-left": ["launcher", "workspaces", "custom-marquee"],
  "modules-center": ["clock"],
  "modules-right": ["network", "custom-notifications", "pulseaudio", "bluetooth", "tray"],

  "launcher": {
    "format": "󰣇",
    "tooltip": false,
    "on-click": "archy-launcher",
    "on-scroll-up": "archy-launcher"
  },

  // Only workspaces that have been used. Ten persistent ones would sit there
  // permanently, which is not what the bar looked like before.
  //
  // The active one is marked in the stylesheet with a filled dot, so there is no
  // background block competing with the wallpaper.
  "workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "sort-by-number": true
  },

  // Scrolling now-playing title. archy-marquee prints a window of the title
  // that advances on its own, and blanks itself when nothing is playing.
  "custom-marquee": {
    "exec": "archy-marquee",
    "interval": 1,
    "format": "{}",
    "tooltip": false
  },

  "clock": {
    "format": "󰥔 {:%H:%M}",
    "format-time": "24H",
    "tooltip-format": "<big>{calendar}</big>"
  },

  "network": {
    "format-wifi": "󰤨 {signalStrength}%",
    "format-ethernet": "󰤨 {ipaddr}",
    "format-disconnected": "󰤭",
    "tooltip-format": "{ifname} via {router}\n{ipaddr}/{mask}",
    "on-click": "archy-network-menu"
  },

  // Notification count. Waybar has no notification module, so this counts mako's
  // history. Right-click dismisses all of them, left-click opens the list.
  "custom-notifications": {
    "exec": "archy-notifications count",
    "interval": 2,
    "format": "󰂚 {}",
    "tooltip": false,
    "on-click": "archy-notifications list",
    "on-scroll-up": "archy-notifications dismiss-last",
    "on-scroll-down": "archy-notifications dismiss-all"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": {
      "default": ["󰕾"],
      "headphone": ["󰔏"],
      "headset": ["󰖅"],
      "speaker": ["󰕾"],
      "mic": ["󰍉"]
    },
    "on-click": "archy-volume raise",
    "on-scroll-up": "archy-volume raise",
    "on-scroll-down": "archy-volume lower"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱",
    "format-disabled": "󰂲",
    "tooltip-format": "{device_alias}\n{status}",
    "on-click": "archy-bluetooth-menu"
  },

  "tray": {
    "icon-size": 14,
    "spacing": 6,
    "tooltip": false
  }
}
