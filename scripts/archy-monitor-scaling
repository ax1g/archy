#!/usr/bin/env bash
# archy:monitor-scaling -- read or set the focused monitor's scale.
#
# Usage: archy-monitor-scaling <up|down|SCALE>

source "$(dirname "$(readlink -f "$0")")/lib.sh"

# A 1080p panel is already at native density, so the ladder starts above 1:
# anything lower is a supersample that costs GPU for no visible gain here.
SCALES=(1 1.25 1.5 1.75 2 2.5 3)

focused_output() {
  hyprctl -j monitors 2>/dev/null | jq -r '.[] | select(.focused == true) | .name'
}

focused_scale() {
  hyprctl -j monitors 2>/dev/null | jq -r '.[] | select(.focused == true) | .scale'
}

case "${1:-}" in
up | down)
  current="$(focused_scale)" || exit 1
  current_index=0
  for i in "${!SCALES[@]}"; do
    if [[ $(awk -v a="${SCALES[$i]}" -v b="$current" 'BEGIN { print (a == b) ? 1 : 0 }') == "1" ]]; then
      current_index=$i
      break
    fi
  done

  if [[ ${1:-} == "up" ]]; then
    ((current_index < ${#SCALES[@]} - 1)) && current_index=$((current_index + 1))
  else
    ((current_index > 0)) && current_index=$((current_index - 1))
  fi
  target="${SCALES[$current_index]}"
  ;;

*)
  target="${1:-}"
  [[ -n $target ]] || {
    printf '%s\n' "$(focused_scale)"
    exit 0
  }
  ;;
esac

output="$(focused_output)" || exit 1
[[ -n $output ]] || exit 1

hyprctl keyword "monitor $output, scale, $target" >/dev/null 2>&1 || exit 1

notify "display-brightness  scale ${target}" low
printf '%s\n' "$target"
