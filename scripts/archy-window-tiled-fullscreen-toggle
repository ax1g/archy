#!/usr/bin/env bash
# archy:window-tiled-fullscreen-toggle -- fullscreen that ignores the layout.
#
# Hyprland's plain fullscreen has a maximized variant, but what is actually
# wanted here is "cover the work area and keep the layout untouched", which is
# what a client-side fullscreen request on a tiled window effectively does.

source "$(dirname "$(readlink -f "$0")")/lib.sh"

window="$(active_address)" || exit 0
state="$(hyprctl -j activewindow 2>/dev/null | jq -r 'if .fullscreen == 0 then "off" else "on" end')"

if [[ $state == "on" ]]; then
  hypr_dispatch "hl.dsp.window.fullscreen({ window = \"$window\", mode = \"fullscreen\" })" fullscreen 0 "$window"
else
  hypr_dispatch "hl.dsp.window.fullscreen({ window = \"$window\", mode = \"fullscreen\" })" fullscreen 1 "$window"
fi
