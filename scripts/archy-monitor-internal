#!/usr/bin/env bash
# archy:monitor-internal -- enable, disable or toggle a laptop's internal panel.
#
# Usage: archy-monitor-internal <toggle|on|off>
#
# A no-op on a desktop, so the binding is harmless either way.

source "$(dirname "$(readlink -f "$0")")/lib.sh"

# Internal panels are the eDP outputs. Nothing matches on a desktop.
internals="$(hyprctl -j monitors 2>/dev/null | jq -r '.[] | select(.name | startswith("eDP-")) | .name')"
[[ -n $internals ]] || exit 0

state="$(hyprctl -j monitors 2>/dev/null |
  jq -r '[.[] | select(.name | startswith("eDP-"))][0].disabled // false')"

case "${1:-toggle}" in
on)
  [[ $state == "true" ]] && exit 0
  action="enable"
  ;;
off)
  [[ $state == "false" ]] && exit 0
  action="disable"
  ;;
toggle)
  if [[ $state == "true" ]]; then
    action="enable"
  else
    action="disable"
  fi
  ;;
*)
  echo "Usage: archy-monitor-internal <toggle|on|off>" >&2
  exit 1
  ;;
esac

for output in $internals; do
  hyprctl keyword "monitor $output, disable, $action" >/dev/null 2>&1
done

notify "Laptop display  $action" low
