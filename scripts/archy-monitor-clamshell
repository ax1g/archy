#!/usr/bin/env bash
# archy:monitor-clamshell -- on lid close, turn the internal panel off and
# mirror onto whatever external output is connected.
#
# The reverse (lid open) is a switch binding in bindings.lua, and it locks the
# session: a clamshell that reopens with no lock is a desktop anyone walking
# past can use.

source "$(dirname "$(readlink -f "$0")")/lib.sh"

internals="$(hyprctl -j monitors 2>/dev/null | jq -r '.[] | select(.name | startswith("eDP-")) | .name')"
externals="$(hyprctl -j monitors 2>/dev/null | jq -r '.[] | select(.name | startswith("eDP-") | not) | .name')"

# Lid closed with no external display: there is nothing to mirror onto, so leave
# the panel alone and let the session lock. Turning it off would leave a black
# screen with no way back.
[[ -n $internals ]] || exit 0
[[ -n $externals ]] || exit 0

primary="$(printf '%s\n' $externals | head -n1)"

for output in $internals; do
  hyprctl keyword "monitor $output, disable" >/dev/null 2>&1
done
hyprctl keyword "monitor $primary, mirror, $primary" >/dev/null 2>&1
