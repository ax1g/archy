#!/usr/bin/env bash
# archy:wallpaper-menu -- pick a wallpaper from wallpapers/ and set it.
#
# Uses swww, which animates the transition instead of cutting, and runs its
# daemon in the background if it is not already up.

source "$(dirname "$(readlink -f "$0")")/lib.sh"

WALLPAPER_DIR="$ARCHY_HOME/wallpapers"
mkdir -p "$WALLPAPER_DIR"

ensure_swww() {
  pgrep -x swww-daemon >/dev/null || setsid -f swww-daemon >/dev/null 2>&1
  sleep 0.3
}

if [[ ! -d $WALLPAPER_DIR ]] || [[ -z $(ls -A "$WALLPAPER_DIR"/*.{jpg,jpeg,png,webp} 2>/dev/null) ]]; then
  notify "No wallpapers in $WALLPAPER_DIR" normal
  exit 1
fi

current="$(cat "$ARCHY_STATE_DIR/wallpaper" 2>/dev/null || true)"

entries="$(for f in "$WALLPAPER_DIR"/*.{jpg,jpeg,png,webp}; do
  [[ -r $f ]] || continue
  name="$(basename "$f")"
  if [[ $current == "$f" ]]; then
    printf '%s (active)\t%s\n' "$name" "$f"
  else
    printf '%s\t%s\n' "$name" "$f"
  fi
done)"

chosen="$(printf '%s\n' "$entries" | wofi --dmenu \
  --config "$ARCHY_HOME/wofi/config.rasi" \
  --style "$ARCHY_GENERATED/wofi.css" \
  --prompt "Wallpaper" \
  --hide-input \
  -)"
[[ -n $chosen ]] || exit 0

file="$(printf '%s' "$chosen" | cut -f2)"
[[ -r $file ]] || exit 1

ensure_swww
# Any transition other than "none" covers the fact that the desktop was
# frosted-over a moment ago and is now opaque: a crossfade hides the redraw.
swww img "$file" --transition-type any --transition-fps 60 --transition-duration 0.6 >/dev/null 2>&1

printf '%s' "$file" >"$ARCHY_STATE_DIR/wallpaper"
