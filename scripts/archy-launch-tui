#!/usr/bin/env bash
# archy:launch-tui -- run a TUI program in kitty, or focus it if it is already
# open.
#
# Usage: archy-launch-tui <command> [args...]

source "$(dirname "$(readlink -f "$0")")/lib.sh"

[[ $# -gt 0 ]] || exit 1

# A stable class per program, so the window can be found again on the next
# launch. Kitty's --class is what Hyprland reports as the window class.
#
# The TUI. prefix is deliberate, and windows.lua's terminal rule matches it: a
# kitty window running a TUI is still a terminal, so it still gets the
# "terminal" tag that the universal clipboard chords and the cascade's terminal
# exemption both read.
app_id="TUI.$(basename "${1%% *}")"
if [[ $# -gt 1 ]]; then
  app_id="$app_id.$(printf '%s' "${*:2}" | tr -c '[:alnum:]' '_' | cut -c1-24)"
fi

# Focus the existing window rather than opening a second copy.
existing="$(hyprctl -j clients 2>/dev/null |
  jq -r --arg id "$app_id" '.[] | select(.class == $id) | .address' | head -n1)"

if [[ -n $existing ]]; then
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$existing\" })" >/dev/null 2>&1
  exit 0
fi

# kitty, not a wrapper: the class has to be set at launch so the window is
# findable next time.
setsid -f kitty --class "$app_id" -e "$@" >/dev/null 2>&1
