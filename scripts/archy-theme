#!/usr/bin/env bash
# archy:theme -- read and apply colors/colors.conf.
#
# Usage:
#   archy-theme sync     regenerate the generated stylesheets
#   archy-theme apply    sync, then reload Hyprland and the bar
#   archy-theme current  print the theme name
#   archy-theme list     list available themes in colors/themes/

source "$(dirname "$(readlink -f "$0")")/lib.sh"

[[ -r $ARCHY_COLORS ]] || {
  echo "archy: no colors file at $ARCHY_COLORS" >&2
  exit 1
}

# Hex to the rgb(r,g,b) form GTK's CSS parser wants, for a one-off literal.
# Most of the output uses @define-color instead, which is the readable path.
hex_to_rgb() {
  local hex="${1#\#}"
  [[ -n $hex ]] || return 1
  case ${#hex} in
  3)
    hex="${hex:0:1}${hex:0:1}${hex:1:1}${hex:1:1}${hex:2:1}${hex:2:1}"
    ;;
  8)
    hex="${hex:0:6}"
    ;;
  esac
  printf 'rgb(%d,%d,%d)' \
    "$((16#${hex:0:2}))" "$((16#${hex:2:2}))" "$((16#${hex:4:2}))"
}

# Emit the palette as GTK @define-color declarations.
#
# Waybar and Wofi both render through GTK, and GTK's CSS parser has no support
# for CSS custom properties, so `--name: value` would be silently dropped and
# the bar would come up with no colors at all. @define-color is the syntax
# both actually understand.
#
# Every consumer reads the same names, so adding a color to colors.conf means
# adding a name here and nowhere else.
emit_gtk_colors() {
  local key
  for key in background dark_background darker_background lighter_background \
    foreground dark_foreground light_foreground bright_foreground \
    accent selection muted \
    red yellow orange green cyan blue magenta brown \
    bright_red bright_yellow bright_green bright_cyan bright_blue bright_magenta; do
    local value
    value="$(color "$key")"
    [[ -n $value ]] && printf '@define-color %s %s;\n' "$key" "$value"
  done
}

sync_waybar_css() {
  local out="$ARCHY_GENERATED/waybar.css"
  {
    printf '/* Generated by archy-theme from colors/colors.conf. Do not edit. */\n'
    printf '/* Theme: %s */\n' "$(color name)"
    printf '/* Palette first, then waybar/style.css verbatim. Waybar accepts */\n'
    printf '/* exactly one stylesheet, so the two are concatenated rather than */\n'
    printf '/* imported, and the hand-written file can use @define-color names. */\n\n'
    emit_gtk_colors
    printf '\n'
  } >"$out"

  # Append the hand-written layout, which references the names above.
  [[ -r "$ARCHY_HOME/waybar/style.css" ]] && cat "$ARCHY_HOME/waybar/style.css" >>"$out"
  return 0
}

sync_wofi_css() {
  local out="$ARCHY_GENERATED/wofi.css"
  {
    printf '/* Generated by archy-theme from colors/colors.conf. Do not edit. */\n'
    printf '/* Theme: %s */\n\n' "$(color name)"
    emit_gtk_colors
    printf '\n'
    printf 'window {\n'
    printf '  background-color: @darker_background;\n'
    printf '  color: @foreground;\n'
    printf '  text-color: @foreground;\n'
    printf '  border: 2px solid @muted;\n'
    printf '  border-radius: 8px;\n'
    printf '}\n\n'
    printf '#input {\n'
    printf '  background-color: @dark_background;\n'
    printf '  color: @bright_foreground;\n'
    printf '  border-bottom: 2px solid @accent;\n'
    printf '}\n\n'
    printf '#entry {\n'
    printf '  color: @bright_foreground;\n'
    printf '}\n\n'
    printf '#listview {\n'
    printf '  background-color: @darker_background;\n'
    printf '  border-radius: 8px;\n'
    printf '}\n\n'
    printf '#scrollbar {\n'
    printf '  background-color: @dark_background;\n'
    printf '  border-radius: 8px;\n'
    printf '}\n\n'
    printf '.item {\n'
    printf '  border-radius: 8px;\n'
    printf '}\n\n'
    printf '.selected {\n'
    printf '  background-color: @selection;\n'
    printf '  color: @bright_foreground;\n'
    printf '  /* Left edge rather than a filled row: at this height a full-width */\n'
    printf '  /* fill competes with the icons for attention. */\n'
    printf '  border-left: 3px solid @accent;\n'
    printf '}\n\n'
    printf '.urgent {\n'
    printf '  color: @red;\n'
    printf '}\n'
  } >"$out"
}

# Mako is a GTK application configured through a keyfile, not a stylesheet, so
# this emits [section] pairs rather than CSS.
sync_mako_conf() {
  local out="$ARCHY_GENERATED/mako.conf"
  {
    printf '# Generated by archy-theme from colors/colors.conf. Do not edit.\n'
    printf '# Theme: %s\n\n' "$(color name)"
    printf '[notification]\n'
    printf 'anchor=top-right\n'
    printf 'background-color=%s\n' "$(color darker_background)"
    printf 'text-color=%s\n' "$(color foreground)"
    printf 'border-color=%s\n' "$(color muted)"
    printf 'border-size=2\n'
    printf 'border-radius=8\n'
    printf 'width=420\n'
    printf 'padding=12\n'
    printf 'margin=12\n'
    printf 'icon-padding=12\n'
    printf 'summary-font=JetBrainsMono Nerd Font Bold 13\n'
    printf 'body-font=JetBrainsMono Nerd Font 12\n'
    printf 'font=JetBrainsMono Nerd Font 12\n'
    printf 'summary-color=%s\n' "$(color bright_foreground)"
    printf 'body-color=%s\n' "$(color light_foreground)"
    printf 'text-color=%s\n' "$(color foreground)"
    printf 'action-color=%s\n' "$(color accent)"
    printf 'close-button-color=%s\n' "$(color muted)"
    printf '\n[history]\n'
    printf 'no-recents=false\n'
    printf '\n[daemon]\n'
    printf 'icon-path=%s\n' "$ARCHY_HOME/generated/icons"
  } >"$out"
}

# hyprlock draws QML, so its colors go in as a literal. Generating it rather
# than keeping it in the repo means a theme change reaches the lock screen too.
sync_hyprlock_qml() {
  local out="$ARCHY_GENERATED/hyprlock.qml"
  {
    printf '// Generated by archy-theme from colors/colors.conf. Do not edit.\n'
    printf '// Theme: %s\n\n' "$(color name)"
    printf 'import QtQuick\n'
    printf 'import Hyprland\n\n'
    printf 'ShellRoot {\n'
    printf '  color: "%s"\n\n' "$(color darker_background)"
    printf '  // No animation: a lock surface that slides or fades in leaves a\n'
    printf '  // visible uncommitted buffer behind it, which flashes.\n'
    printf '  Text {\n'
    printf '    id: clock\n'
    printf '    color: "%s"\n' "$(color bright_foreground)"
    printf '    font.family: "JetBrainsMono Nerd Font"\n'
    printf '    font.size: 96\n'
    printf '    font.weight: Font.Bold\n'
    printf '    anchors.centerIn: parent\n'
    printf '    text: Time.hour + ":" + Time.minute\n'
    printf '  }\n\n'
    printf '  Text {\n'
    printf '    color: "%s"\n' "$(color dark_foreground)"
    printf '    font.family: "JetBrainsMono Nerd Font"\n'
    printf '    font.size: 18\n'
    printf '    anchors.top: clock.bottom\n'
    printf '    anchors.topMargin: 12\n'
    printf '    anchors.horizontalCenter: clock.horizontalCenter\n'
    printf '    text: Hyprland.date\n'
    printf '  }\n\n'
    printf '  Rectangle {\n'
    printf '    anchors.top: parent.top\n'
    printf '    width: parent.width\n'
    printf '    height: 3\n'
    printf '    color: "%s"\n' "$(color accent)"
    printf '  }\n\n'
    printf '  Text {\n'
    printf '    color: "%s"\n' "$(color muted)"
    printf '    font.family: "JetBrainsMono Nerd Font"\n'
    printf '    font.size: 14\n'
    printf '    anchors.bottom: parent.bottom\n'
    printf '    anchors.bottomMargin: 48\n'
    printf '    anchors.horizontalCenter: parent.horizontalCenter\n'
    printf '    text: "SUPER+SPACE launch  ·  SUPER+ESCAPE power"\n'
    printf '  }\n'
    printf '}\n'
  } >"$out"
}

# Kitty takes a plain include line, not a keyfile and not CSS, so the palette
# is written as kitty color directives. This replaces the theme fragment the
# terminal used to include from the Omarchy tree.
sync_kitty_conf() {
  local out="$ARCHY_GENERATED/kitty.conf"
  {
    printf '# Generated by archy-theme from colors/colors.conf. Do not edit.\n'
    printf '# Theme: %s\n\n' "$(color name)"
    printf 'foreground %s\n' "$(color foreground)"
    printf 'background %s\n' "$(color background)"
    printf 'selection_foreground %s\n' "$(color bright_foreground)"
    printf 'selection_background %s\n' "$(color selection)"
    printf '\ncursor %s\n' "$(color bright_foreground)"
    printf 'cursor_text_color %s\n' "$(color background)"
    printf '\nactive_border_color %s\n' "$(color accent)"
    printf 'active_tab_background %s\n' "$(color accent)"
    printf '\nurl_color %s\n' "$(color blue)"

    local i=0
    local palette=(
      background red green yellow blue magenta cyan foreground
      muted bright_red bright_green bright_yellow bright_blue bright_magenta
      bright_cyan bright_foreground
    )
    for key in "${palette[@]}"; do
      printf 'color%d %s\n' "$i" "$(color "$key")"
      i=$((i + 1))
    done
  } >"$out"
}

do_sync() {
  sync_waybar_css
  sync_wofi_css
  sync_mako_conf
  sync_hyprlock_qml
  sync_kitty_conf
}

do_apply() {
  do_sync
  # Reload Hyprland first so the compositor has the new colors, then restart the
  # surfaces that cache their palette at startup. hyprctl reload re-runs the
  # Lua config, which is why it goes before anything is killed: a reloaded
  # compositor with no bar is a normal intermediate state, a killed bar with no
  # compositor is a black screen.
  hyprctl reload >/dev/null 2>&1

  pkill -x waybar >/dev/null 2>&1
  setsid -f waybar -c "$ARCHY_HOME/waybar/config.jsonc" -s "$ARCHY_GENERATED/waybar.css" >/dev/null 2>&1

  pkill -x mako >/dev/null 2>&1
  setsid -f mako -c "$ARCHY_GENERATED/mako.conf" >/dev/null 2>&1

  # Kitty reads its palette with an include, and only at startup, so an already
  # open terminal keeps the old colors until it is restarted. Closing them is
  # too destructive to do unasked, so this says which ones are stale instead.
  stale="$(pgrep -x kitty >/dev/null 2>&1 && echo yes || echo no)"
  [[ $stale == yes ]] && notify "Theme applied. Open kitty windows keep the old colors until restarted." low

  # hyprlock is only reloaded if it happens to be up; a config change applies
  # to the next lock, so a running one is left alone.
  if pgrep -x hyprlock >/dev/null 2>&1; then
    pkill -x hyprlock
  fi

  notify "Theme  $(color name)" low
}

case "${1:-sync}" in
sync) do_sync ;;
apply) do_apply ;;
current) color name ;;
list)
  if [[ -d "$ARCHY_HOME/colors/themes" ]]; then
    for f in "$ARCHY_HOME"/colors/themes/*.conf; do
      [[ -r $f ]] || continue
      printf '%s\n' "$(basename "$f" .conf)"
    done
  fi
  ;;
*)
  echo "Usage: archy-theme <sync|apply|current|list>" >&2
  exit 1
  ;;
esac
