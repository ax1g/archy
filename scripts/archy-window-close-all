#!/usr/bin/env bash
# archy:window-close-all -- close every window on the current workspace.

source "$(dirname "$(readlink -f "$0")")/lib.sh"

# Work from the address list, not a live loop: closing a window changes the
# list, so iterating it while dispatching skips windows.
addrs="$(hyprctl -j clients 2>/dev/null | jq -r --arg ws "$(hyprctl -j activeworkspace | jq -r '.id')" '
  .[] | select(.workspace.id == ($ws | tonumber)) | .address')"

for addr in $addrs; do
  hyprctl dispatch "hl.dsp.window.close({ window = \"address:$addr\" })" >/dev/null 2>&1
done
