#!/usr/bin/env bash
# archy:toggle -- flip a compositor setting and report the new value.
#
# Usage: archy-toggle <bar|transparency|gaps|single-square|idle|nightlight>

source "$(dirname "$(readlink -f "$0")")/lib.sh"

what="${1:-}"
[[ -n $what ]] || {
  echo "Usage: archy-toggle <bar|transparency|gaps|single-square>" >&2
  exit 1
}

# Read a boolean keyword's current value.
keyword_bool() {
  hyprctl -j getoption "$1" 2>/dev/null | jq -r '.int // 0'
}

# Flip a boolean keyword, then return the new value.
toggle_keyword_bool() {
  local key="$1" current next
  current="$(keyword_bool "$key")"
  if ((current == 1)); then
    next="false"
  else
    next="true"
  fi
  hyprctl keyword "$key, $next" >/dev/null 2>&1
  ((next == "true")) && printf 'on' || printf 'off'
}

case "$what" in
bar)
  if pgrep -x waybar >/dev/null 2>&1; then
    pkill -x waybar
    notify "Bar hidden" low
  else
    setsid -f waybar >/dev/null 2>&1
    notify "Bar shown" low
  fi
  ;;

transparency)
  # The frost lives in the default-opacity window rule, which keys off a tag
  # rather than a keyword. Toggle by retagging every window, which is what
  # actually changes what is on screen.
  tagged="$(hyprctl -j clients 2>/dev/null |
    jq -r '[.[] | select((.tags // []) | index("default-opacity"))] | length')"
  if ((tagged > 0)); then
    while read -r addr; do
      [[ -n $addr ]] || continue
      hyprctl dispatch "hl.dsp.window.tag({ window = \"address:$addr\", tag = \"-default-opacity\" })" >/dev/null 2>&1
    done < <(hyprctl -j clients 2>/dev/null | jq -r '.[] | select((.tags // []) | index("default-opacity")) | .address')
    notify "Transparency off" low
  else
    while read -r addr; do
      [[ -n $addr ]] || continue
      hyprctl dispatch "hl.dsp.window.tag({ window = \"address:$addr\", tag = \"+default-opacity\" })" >/dev/null 2>&1
    done < <(hyprctl -j clients 2>/dev/null | jq -r '.[] | .address')
    notify "Transparency on" low
  fi
  ;;

gaps)
  state="$(toggle_keyword_bool "general:gaps_in")"
  if [[ $state == on ]]; then
    hyprctl keyword "general:gaps_in, 0" >/dev/null 2>&1
    hyprctl keyword "general:gaps_out, 0" >/dev/null 2>&1
  else
    hyprctl keyword "general:gaps_in, 4" >/dev/null 2>&1
    hyprctl keyword "general:gaps_out, 8" >/dev/null 2>&1
  fi
  notify "Gaps  $state" low
  ;;

single-square)
  # single_window_aspect_ratio is a ratio, not a bool: 1,1 is square, 0,0 is off.
  current="$(hyprctl -j getoption layout:single_window_aspect_ratio 2>/dev/null | jq -r '.int // 0')"
  if ((current == 1)); then
    hyprctl keyword "layout:single_window_aspect_ratio, 0 0" >/dev/null 2>&1
    notify "Single-window square  off" low
  else
    hyprctl keyword "layout:single_window_aspect_ratio, 1 1" >/dev/null 2>&1
    notify "Single-window square  on" low
  fi
  ;;

*)
  echo "Unknown toggle: $what" >&2
  exit 1
  ;;
esac
